@model IEnumerable<Versta_test_project.Models.OrderModel>
@{
    ViewData["Title"] = "Просмотр заказов";
}

<h1>Просмотр заказов</h1>

<table class="table">
    <thead>
        <tr>
            <th>Номер заказа</th>
            <th>Город отправителя</th>
            <th>Адрес отправителя</th>
            <th>Город получателя</th>
            <th>Адрес получателя</th>
            <th>Вес груза</th>
            <th>Дата забора груза</th>
        </tr>
    </thead>
    <tbody>
        @foreach (OrderModel order in Model)
        {
            <tr style="cursor: pointer;" onclick="window.location.href='@Url.Action("ViewOrderDetails", "Orders", new { id = order.ID })'">
                <td>@order.ID</td>
                <td>@order.senderCity</td>
                <td>@order.senderAddress</td>
                <td>@order.recipientCity</td>
                <td>@order.recipientAddress</td>
                <td>@order.packageWeight</td>
                <td>@order.collectionDate</td>
            </tr>
        }
    </tbody>
</table>